# Huawei AI DevSpace verification: keep Mock enabled until each adapter is ready.
APP_NAME=YunSync HealthLoop
ENVIRONMENT=devspace
API_V1_PREFIX=/api/v1
SECRET_KEY=development-only
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
ENABLE_DEMO_LOGIN=true
SESSION_TTL_HOURS=12
DATABASE_URL=sqlite:///./backend/data/yunsync.db
REDIS_URL=redis://localhost:6379/0
USE_MOCK_AI=true
HUAWEI_REGION=cn-north-4
HUAWEI_PROJECT_ID=
HUAWEI_ACCESS_KEY=
HUAWEI_SECRET_KEY=
HUAWEI_OCR_ENDPOINT=
HUAWEI_MAAS_ENDPOINT=
HUAWEI_MAAS_API_KEY=
HUAWEI_OBS_BUCKET=
