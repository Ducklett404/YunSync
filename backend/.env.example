# Local development defaults. Replace these through secure deployment variables.
YUNSYNC_APP_ENV=development
YUNSYNC_DATABASE_URL=postgresql+psycopg://yunsync_app:change-me@127.0.0.1:5432/yunsync
YUNSYNC_REDIS_URL=redis://127.0.0.1:6379/0
YUNSYNC_WEATHER_API_URL=https://weather.example.invalid/v1/current
YUNSYNC_WEATHER_API_KEY=
YUNSYNC_WEATHER_PROVIDER=configured-weather-service
YUNSYNC_WEATHER_TIMEOUT_SECONDS=3.5
YUNSYNC_CACHE_VERSION=m12-v1
YUNSYNC_RECOMMENDATION_TTL_SECONDS=900
YUNSYNC_WEATHER_TTL_SECONDS=1800
YUNSYNC_NEGATIVE_TTL_SECONDS=60
YUNSYNC_RATE_LIMIT_REQUESTS=60
YUNSYNC_RATE_LIMIT_WINDOW_SECONDS=60
YUNSYNC_ALLOW_DEMO_CONTENT=true
YUNSYNC_SEED_DEMO_CONTENT=true
YUNSYNC_CORS_ORIGINS=http://localhost:5173
