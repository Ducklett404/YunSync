# Application
APP_NAME=YunSync HealthLoop
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-this-before-deployment
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
ENABLE_DEMO_LOGIN=true
SESSION_TTL_HOURS=12

# Local default. Replace with PostgreSQL for Huawei Cloud RDS.
DATABASE_URL=sqlite:///./backend/data/yunsync.db
# DATABASE_URL=postgresql+psycopg://yunsync:password@postgres:5432/yunsync

# Optional cache. The application falls back gracefully when Redis is unavailable.
REDIS_URL=redis://localhost:6379/0

# Huawei Cloud integrations. Keep secrets out of Git.
USE_MOCK_AI=true
HUAWEI_REGION=cn-north-4
HUAWEI_PROJECT_ID=
HUAWEI_ACCESS_KEY=
HUAWEI_SECRET_KEY=
HUAWEI_OCR_ENDPOINT=
HUAWEI_MAAS_ENDPOINT=
HUAWEI_MAAS_API_KEY=
HUAWEI_OBS_BUCKET=
