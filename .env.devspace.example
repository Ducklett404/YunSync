# Huawei AI DevSpace verification: keep Mock enabled until each adapter is ready.
APP_NAME=YunSync HealthLoop
ENVIRONMENT=devspace
API_V1_PREFIX=/api/v1
SECRET_KEY=development-only
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FORWARDED_ALLOW_IPS=127.0.0.1
FORCE_HTTPS=false
EXPOSE_API_DOCS=true
LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD_MS=500
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000
MONITORING_ENABLED=false
MONITORING_TOKEN=
ENABLE_DEMO_LOGIN=true
SEED_DEMO_DATA=true
RUN_MIGRATIONS_ON_STARTUP=true
SESSION_TTL_HOURS=12
ACCOUNT_DELETION_GRACE_HOURS=72
EXPIRED_SESSION_RETENTION_DAYS=7
DATABASE_URL=sqlite:///./backend/data/yunsync.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=false
CACHE_NAMESPACE=yunsync
CACHE_TTL_SECONDS=300
CACHE_CONNECT_TIMEOUT_SECONDS=0.3
CACHE_SOCKET_TIMEOUT_SECONDS=0.5
USE_MOCK_AI=true
USE_LOCAL_STORAGE=true
UPLOAD_STORAGE_DIR=backend/data/uploads
OCR_TIMEOUT_SECONDS=8
OCR_MAX_ATTEMPTS=2
MAAS_TIMEOUT_SECONDS=8
MAAS_MAX_TOKENS=320
HUAWEI_REGION=cn-north-4
HUAWEI_CREDENTIAL_MODE=environment
HUAWEI_PROJECT_ID=
HUAWEI_ACCESS_KEY=
HUAWEI_SECRET_KEY=
HUAWEI_OCR_ENDPOINT=
HUAWEI_MAAS_ENDPOINT=
HUAWEI_MAAS_API_KEY=
HUAWEI_MAAS_MODEL=
HUAWEI_OBS_ENDPOINT=
HUAWEI_OBS_BUCKET=
HUAWEI_OBS_VALIDATION_REF=
HUAWEI_OCR_VALIDATION_REF=
HUAWEI_MAAS_VALIDATION_REF=
RELEASE_IMAGE_REF=
BACKUP_RESTORE_VALIDATION_REF=
HTTPS_VALIDATION_REF=
ALERTING_VALIDATION_REF=
PROFESSIONAL_REVIEW_VALIDATION_REF=
USER_TEST_VALIDATION_REF=
CUSTOMER_ACCEPTANCE_VALIDATION_REF=
