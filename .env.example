# Application
APP_NAME=YunSync HealthLoop
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-this-before-deployment
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FORWARDED_ALLOW_IPS=127.0.0.1
FORCE_HTTPS=false
EXPOSE_API_DOCS=true
LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD_MS=500
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000
ENABLE_DEMO_LOGIN=true
SEED_DEMO_DATA=true
RUN_MIGRATIONS_ON_STARTUP=true
SESSION_TTL_HOURS=12

# Local default. Replace with PostgreSQL for Huawei Cloud RDS.
DATABASE_URL=sqlite:///./backend/data/yunsync.db
# DATABASE_URL=postgresql+psycopg://yunsync:password@postgres:5432/yunsync
# MIGRATION_DATABASE_URL is read by docker-compose only; omit it for local SQLite.
# MIGRATION_DATABASE_URL=postgresql+psycopg://migrator:password@postgres:5432/yunsync
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# Optional cache. The application falls back gracefully when Redis is unavailable.
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=false
CACHE_NAMESPACE=yunsync
CACHE_TTL_SECONDS=300
CACHE_CONNECT_TIMEOUT_SECONDS=0.3
CACHE_SOCKET_TIMEOUT_SECONDS=0.5

# Huawei Cloud integrations. Keep secrets out of Git.
USE_MOCK_AI=true
USE_LOCAL_STORAGE=true
UPLOAD_STORAGE_DIR=backend/data/uploads
OCR_TIMEOUT_SECONDS=8
OCR_MAX_ATTEMPTS=2
MAAS_TIMEOUT_SECONDS=8
HUAWEI_REGION=cn-north-4
HUAWEI_CREDENTIAL_MODE=environment
HUAWEI_PROJECT_ID=
HUAWEI_ACCESS_KEY=
HUAWEI_SECRET_KEY=
HUAWEI_OCR_ENDPOINT=
HUAWEI_MAAS_ENDPOINT=
HUAWEI_MAAS_API_KEY=
HUAWEI_OBS_BUCKET=
