# Install as /etc/nginx/sites-enabled/yunsync-api.conf after filling domain/cert paths.
server {
    listen 443 ssl;
    server_name api.example.invalid;
    ssl_certificate /etc/ssl/yunsync/fullchain.pem;
    ssl_certificate_key /etc/ssl/yunsync/privkey.pem;
    location / {
        include /etc/nginx/snippets/yunsync-upstream.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
