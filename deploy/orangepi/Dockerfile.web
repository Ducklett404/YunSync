FROM node:22-bookworm-slim AS build

WORKDIR /app/miniapp
COPY miniapp/package.json miniapp/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY miniapp/ ./
# Same-origin proxy: the build works with any board IP or hostname.
ENV VITE_DATA_MODE=demo \
    VITE_YUNSYNC_API_BASE_URL=/api
RUN npm run build:h5

FROM nginx:1.28-alpine
COPY deploy/orangepi/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/miniapp/dist/build/h5/ /usr/share/nginx/html/
EXPOSE 80
