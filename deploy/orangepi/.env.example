# Generated locally by board.sh init. Keep this file with database backups.
YUNSYNC_BOARD_HTTP_PORT=8080
YUNSYNC_BOARD_DB_PASSWORD=
# Change all three values if the private proxy network overlaps an existing network.
YUNSYNC_BOARD_PROXY_SUBNET=172.30.84.0/24
YUNSYNC_BOARD_PROXY_IP=172.30.84.2
YUNSYNC_BOARD_PROXY_DYNAMIC_RANGE=172.30.84.128/25
# Cache and rate counters normally rebuild in memory after a restart.
YUNSYNC_BOARD_REDIS_APPENDONLY=no

# Optional server-side services; empty values use the existing rule fallback.
YUNSYNC_WEATHER_API_URL=
YUNSYNC_WEATHER_API_KEY=
YUNSYNC_MAAS_API_URL=
YUNSYNC_MAAS_API_KEY=
YUNSYNC_MAAS_MODEL=
