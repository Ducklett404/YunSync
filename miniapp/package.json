{
  "name": "yunsync-miniapp",
  "version": "0.0.0",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-weixin:release": "node scripts/assert-production-data.mjs && uni build -p mp-weixin",
    "validate:m2": "node scripts/validate-m2-content.mjs",
    "validate:m3": "node scripts/validate-m3.mjs",
    "validate:m4": "node scripts/validate-m4.mjs",
    "validate:m5": "node scripts/validate-m5.mjs",
    "validate:m6": "node scripts/validate-m6.mjs",
    "validate:h5": "npm run build:h5 && node scripts/run-h5-tests.mjs",
    "release:check": "node scripts/assert-production-data.mjs",
    "check:m6": "node scripts/check-m6-acceptance.mjs",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@playwright/test": "^1.63.0",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.1.3",
    "jsonc-parser": "^3.3.1",
    "typescript": "^4.9.4",
    "vite": "5.2.8",
    "vue-tsc": "^1.0.24"
  }
}
