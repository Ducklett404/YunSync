# Dependencies and package-manager caches
node_modules/
.npm-cache*/
**/.npm-cache/

# Generated build output and local runtime files
miniapp/dist/
miniapp/test-results/
miniapp/playwright-report/
*.log
*.tmp

# Local Python packages and caches
.site-packages/
.venv/
.pytest_cache/
.pytest-tmp*/
__pycache__/
*.py[cod]
.coverage
htmlcov/
backend/data/*
!backend/data/.gitkeep

# Local development tools and installers
tools/wechat-devtools/
.local-backups/
CodeArts Agent/

# CodeArts IDE local indexes and machine-specific settings
.codeartsdoer/.codebase/
.codeartsdoer/mcp/
.codeartsdoer/mem-exp-config.json
.codeartsdoer/package.json
.codeartsdoer/rule/metadata.properties

# Developer-specific mini-program settings
project.private.config.json

# Local secrets
.env
.env.*
!.env.example
credentials.csv
*.tfvars
!*.tfvars.example

# Huawei Cloud deployment state and local evidence
.auto-deploy/
**/.terraform/
*.tfstate
*.tfstate.*
