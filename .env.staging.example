# Staging: replace every CHANGE_ME value and inject credentials outside Git.
APP_NAME=YunSync HealthLoop
ENVIRONMENT=staging
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-this-before-deployment
CORS_ORIGINS=https://CHANGE_ME.example.com
ALLOWED_HOSTS=CHANGE_ME.example.com
FORWARDED_ALLOW_IPS=CHANGE_ME_PROXY_IP
FORCE_HTTPS=true
EXPOSE_API_DOCS=false
LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD_MS=500
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000
MONITORING_ENABLED=true
MONITORING_TOKEN=CHANGE_ME_AT_LEAST_24_CHARACTERS
ENABLE_DEMO_LOGIN=true
SEED_DEMO_DATA=true
RUN_MIGRATIONS_ON_STARTUP=false
SESSION_TTL_HOURS=12
ACCOUNT_DELETION_GRACE_HOURS=72
EXPIRED_SESSION_RETENTION_DAYS=7
DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/yunsync
# Only the one-shot migration task receives this higher-privilege identity.
MIGRATION_DATABASE_URL=postgresql+psycopg://CHANGE_ME_MIGRATOR:CHANGE_ME@CHANGE_ME:5432/yunsync
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
REDIS_URL=rediss://:CHANGE_ME@CHANGE_ME:6379/0
CACHE_ENABLED=true
CACHE_NAMESPACE=yunsync
CACHE_TTL_SECONDS=300
CACHE_CONNECT_TIMEOUT_SECONDS=0.3
CACHE_SOCKET_TIMEOUT_SECONDS=0.5
USE_MOCK_AI=true
USE_LOCAL_STORAGE=false
UPLOAD_STORAGE_DIR=/app/uploads
OCR_TIMEOUT_SECONDS=8
OCR_MAX_ATTEMPTS=2
OCR_PDF_MAX_PAGES=10
MAAS_TIMEOUT_SECONDS=8
MAAS_MAX_TOKENS=320
HUAWEI_REGION=cn-north-4
HUAWEI_CREDENTIAL_MODE=environment
HUAWEI_PROJECT_ID=CHANGE_ME
HUAWEI_ACCESS_KEY=CHANGE_ME
HUAWEI_SECRET_KEY=CHANGE_ME
HUAWEI_OCR_ENDPOINT=https://CHANGE_ME
HUAWEI_MAAS_ENDPOINT=https://CHANGE_ME
HUAWEI_MAAS_API_KEY=CHANGE_ME
HUAWEI_MAAS_MODEL=CHANGE_ME
HUAWEI_OBS_ENDPOINT=https://CHANGE_ME
HUAWEI_OBS_BUCKET=CHANGE_ME
HUAWEI_OBS_VALIDATION_REF=CHANGE_ME_AFTER_LIVE_TEST
HUAWEI_OCR_VALIDATION_REF=CHANGE_ME_AFTER_LIVE_TEST
HUAWEI_MAAS_VALIDATION_REF=CHANGE_ME_AFTER_LIVE_TEST
RELEASE_IMAGE_REF=CHANGE_ME_IMAGE_TAG_AT_SHA256_DIGEST
BACKUP_RESTORE_VALIDATION_REF=CHANGE_ME_AFTER_LIVE_TEST
HTTPS_VALIDATION_REF=CHANGE_ME_AFTER_LIVE_TEST
ALERTING_VALIDATION_REF=CHANGE_ME_AFTER_LIVE_TEST
PROFESSIONAL_REVIEW_VALIDATION_REF=CHANGE_ME_AFTER_SIGN_OFF
USER_TEST_VALIDATION_REF=CHANGE_ME_AFTER_USER_TEST
CUSTOMER_ACCEPTANCE_VALIDATION_REF=CHANGE_ME_AFTER_CUSTOMER_SIGN_OFF
